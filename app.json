{
  "expo": {
    "name": "Xpress DJs",
    "slug": "xpress-client",
    "version": "1.0.0",
    "icon": "./src/assets/icon.png",
    "orientation": "portrait",
    "scheme": "xpressclient",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/6adaa737-a3a0-4d16-ad16-361a15fcab94",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xpressentertainment.client",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:xos.xpressdjs.com"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Xpress DJs",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.xpressentertainment.client",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#4b328e"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "xos.xpressdjs.com",
              "pathPrefix": "/auth/reset"
            },
            {
              "scheme": "https",
              "host": "xos.xpressdjs.com",
              "pathPrefix": "/auth/confirm"
            },
            {
              "scheme": "https",
              "host": "xos.xpressdjs.com",
              "pathPrefix": "/auth/set-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icon.png",
          "backgroundColor": "#4b328e",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Xpress DJs to use your photos to set your event header photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6adaa737-a3a0-4d16-ad16-361a15fcab94"
      }
    },
    "owner": "drewsegura"
  }
}
